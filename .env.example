# 1. Firebase Cloud Firestore & Authentication (Google Cloud)
# Get these free from https://console.firebase.google.com -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_REAL_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# 2. Instant Email Notifications to your Gmail Inbox (Optional)
# Get a free access key from https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY="your-web3forms-access-key"
